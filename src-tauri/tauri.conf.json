{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WiZzard",
  "identifier": "com.lucasamion.wizzard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WiZzard",
        "width": 1080,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560,
        "backgroundColor": "#0b0a14"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
